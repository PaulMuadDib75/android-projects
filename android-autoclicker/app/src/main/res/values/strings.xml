<?xml version="1.0" encoding="utf-8"?>

<!--
    res/values/strings.xml
    ══════════════════════
    All user-visible text lives here as named string resources.

    WHY NOT INLINE TEXT?
      Keeping strings in this file means:
        1. You change wording in ONE place instead of hunting through XML and Kotlin.
        2. Future translations (other languages) just add a new strings.xml in a
           different values folder (e.g. values-fr/ for French). The app picks the
           right one automatically based on the device's language setting.

    In layout XML you reference these with @string/name.
    In Kotlin you reference them with getString(R.string.name).
-->

<resources>

    <!-- ── App Identity ─────────────────────────────────────────────────────── -->

    <!-- Shown in the launcher, task switcher, and Settings > Accessibility list -->
    <string name="app_name">Auto-Clicker</string>

    <!-- Shown next to the service toggle in Settings > Accessibility -->
    <string name="accessibility_service_label">Auto-Clicker Service</string>

    <!--
        Shown when the user taps the service name in Settings > Accessibility
        to read more about it before enabling. Keep this honest and clear —
        Android wants users to make an informed decision when enabling
        accessibility services (they are powerful and potentially sensitive).
    -->
    <string name="accessibility_service_description">
        Dispatches automated tap gestures at configured screen coordinates.
        Designed for automating repetitive taps in games and apps.
        Milestone 1: single hardcoded tap at (500, 1000) for testing.
    </string>

    <!-- ── Button Labels ────────────────────────────────────────────────────── -->

    <!-- Button that opens the system Accessibility Settings screen -->
    <string name="btn_open_settings">Open Accessibility Settings</string>

    <!-- Button that fires the test tap; includes the hardcoded coordinates for clarity -->
    <string name="btn_send_tap">Send Tap to (500, 1000)</string>

    <!-- Label for the small target button used to verify injected taps are functionally real -->
    <string name="btn_target_test">TARGET</string>

    <!-- ── Status Messages ──────────────────────────────────────────────────── -->

    <!-- Shown when TapAccessibilityService.instance == null (service not running) -->
    <string name="status_service_off">Service: OFF  —  press the button above to enable it</string>

    <!-- Shown when TapAccessibilityService.instance != null (service is live) -->
    <string name="status_service_on">Service: ON  —  ready to tap!</string>

    <!--
        Shown after the tap button is pressed successfully.
        %1$d and %2$d are integer format placeholders filled in at runtime.
        In MainActivity.kt:
            getString(R.string.status_tap_sent, TAP_X.toInt(), TAP_Y.toInt())
        Produces: "Tap sent to (500, 1000)"
    -->
    <string name="status_tap_sent">Tap sent to (%1$d, %2$d)</string>

    <!-- Shown when the target test button's own onClick fires, proving the injected tap was a real, functional touch event -->
    <string name="status_target_tapped">TARGET BUTTON WAS TAPPED!</string>


    <!-- ── Milestone 2: Overlay ─────────────────────────────────────────────── -->

    <!-- Shown in Settings > Apps > Notifications as the category name for our foreground-service notification -->
    <string name="notification_channel_name">Overlay Running</string>

    <!-- Longer description of the notification channel, shown if the user taps into its settings -->
    <string name="notification_channel_description">Shows a persistent notification while the floating tap-control overlay is active</string>

    <!-- Title of the persistent notification shown while OverlayService is running -->
    <string name="notification_title">Auto-Clicker overlay active</string>

    <!-- Body text of the persistent notification -->
    <string name="notification_text">Tap the floating button to start or stop tapping</string>

    <!-- Button that requests the SYSTEM_ALERT_WINDOW ("draw over other apps") permission -->
    <string name="btn_overlay_permission">Grant Overlay Permission</string>

    <!-- Button that starts OverlayService and shows the floating button -->
    <string name="btn_show_overlay">Show Overlay</string>

    <!-- Button that stops OverlayService and hides the floating button -->
    <string name="btn_hide_overlay">Hide Overlay</string>

    <!-- Shown when SYSTEM_ALERT_WINDOW has not been granted yet -->
    <string name="status_overlay_permission_needed">Overlay permission: NOT GRANTED — tap above to enable</string>

    <!-- Shown when SYSTEM_ALERT_WINDOW is already granted -->
    <string name="status_overlay_permission_granted">Overlay permission: granted</string>

    <!-- Shown when OverlayService.instance == null (floating button not on screen) -->
    <string name="status_overlay_hidden">Overlay: hidden</string>

    <!-- Shown when OverlayService.instance != null (floating button is on screen) -->
    <string name="status_overlay_shown">Overlay: shown — drag it, or tap it to start/stop tapping</string>

    <!-- Accessibility label (screen-reader description) for the floating overlay button itself -->
    <string name="overlay_toggle_content_description">Auto-Clicker floating control button. Drag to move, tap to start or stop tapping.</string>


    <!-- ── Milestone 3: Multi-Point Recording ──────────────────────────────── -->

    <!-- Accessibility label for the new Record button on the floating panel -->
    <string name="overlay_record_content_description">Record button. Tap to start recording a sequence of tap points; tap again to stop.</string>

    <!--
        Static instructional text shown at the top of the full-screen
        recording catcher. This is the in-app half of the recording/replay
        tradeoff explanation — the code comments explain WHY the catcher
        exists, this string tells the USER what's happening right now.
    -->
    <string name="recording_banner_text">Recording — taps here mark points only. The app underneath will NOT receive them until recording stops.</string>

    <!--
        Format string reused in two places: the live point counter inside
        the recording catcher (updates after every tap), and the Toast shown
        when recording stops. %1$d is filled in with recordedPoints.size.
    -->
    <string name="recording_points_counter">%1$d points recorded</string>

    <!-- Label for the button inside the recording catcher that ends the session -->
    <string name="stop_recording_button_text">Stop Recording</string>

</resources>
