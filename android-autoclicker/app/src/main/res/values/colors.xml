<?xml version="1.0" encoding="utf-8"?>

<!--
    res/values/colors.xml
    ══════════════════════
    Defines the colour palette for the app.
    These colour names are referenced in themes.xml to configure the Material
    theme (primary, secondary, status bar colours, etc.).

    Colours are in #AARRGGBB format:
      AA = Alpha (opacity): FF = fully opaque, 00 = fully transparent
      RR = Red   channel (00–FF)
      GG = Green channel (00–FF)
      BB = Blue  channel (00–FF)
-->

<resources>

    <!-- Purple — used as the primary brand colour (action bar, buttons) -->
    <color name="purple_200">#FFBB86FC</color>   <!-- light purple, for dark theme accent -->
    <color name="purple_500">#FF6200EE</color>   <!-- standard Material purple primary -->
    <color name="purple_700">#FF3700B3</color>   <!-- darker purple for status bar / variant -->

    <!-- Teal — used as the secondary accent colour -->
    <color name="teal_200">#FF03DAC5</color>     <!-- light teal, for dark theme -->
    <color name="teal_700">#FF018786</color>     <!-- darker teal for secondary variant -->

    <!-- Neutral -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Bright highlight shown on the status label when the target test button confirms a real injected tap landed -->
    <color name="target_tapped_green">#FF4CAF50</color>

    <!-- Milestone 2: floating overlay button, "OFF" state (tap loop not running) -->
    <color name="overlay_toggle_off_gray">#FF757575</color>

</resources>
