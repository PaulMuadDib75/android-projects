<?xml version="1.0" encoding="utf-8"?>

<!--
    res/layout/activity_main.xml
    ════════════════════════════
    Defines the visual layout for MainActivity — what appears on screen
    and where each widget is positioned.

    ConstraintLayout positions each view using constraints (like measurements
    from the edges of a panel). Each view says things like:
      "my top edge is 24dp below the bottom of that other view"
      "my left and right edges are centred in the parent"

    dp (density-independent pixels) = a unit that scales with screen density,
    so a 24dp margin looks the same physical size on all devices.
    sp (scale-independent pixels)   = dp but also scales with the user's
                                      text size preference (accessibility).
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
        APP TITLE
        ─────────
        A large heading so the screen is immediately recognisable.
        Constrained to: horizontally centred, 48dp from the top.
    -->
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp" />

    <!--
        STATUS LABEL
        ────────────
        Shows the current state of the Accessibility Service at a glance.
        Updated in MainActivity.onResume() and when the tap button is pressed.

        Possible values (from strings.xml):
          • "Service: OFF — tap the button above to enable it"
          • "Service: ON — ready to tap!"
          • "Tap sent to (500, 1000)"

        Constrained to: 24dp below the title, horizontally centred.
    -->
    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/status_service_off"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        tools:text="Service: ON — ready to tap!" />

    <!--
        OPEN ACCESSIBILITY SETTINGS BUTTON
        ────────────────────────────────────
        Sends the user to Settings > Accessibility so they can enable the service.
        We can't enable it programmatically — Android requires a manual user action.

        Constrained to: 32dp below the status text, horizontally centred.
    -->
    <Button
        android:id="@+id/buttonOpenSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_settings"
        app:layout_constraintTop_toBottomOf="@id/textViewStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!--
        SEND TAP BUTTON
        ────────────────
        The main test button for Milestone 1.
        Calls TapAccessibilityService.instance?.performTap(500f, 1000f) via MainActivity.

        Constrained to: 16dp below the Settings button, horizontally centred.
    -->
    <Button
        android:id="@+id/buttonSendTap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_send_tap"
        app:layout_constraintTop_toBottomOf="@id/buttonOpenSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!--
        ═══════════════════════════════════════════════════════════════════
        MILESTONE 2: OVERLAY CONTROLS
        ═══════════════════════════════════════════════════════════════════
    -->

    <!--
        OVERLAY STATUS LABEL
        ─────────────────────
        Separate from textViewStatus above (which is about the tap/service
        state and gets overwritten by the Send Tap / Target Test buttons).
        Refreshed in MainActivity.onResume() to reflect both the
        SYSTEM_ALERT_WINDOW permission state and whether OverlayService is
        currently running.
    -->
    <TextView
        android:id="@+id/textViewOverlayStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/status_overlay_permission_needed"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/buttonSendTap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        tools:text="Overlay permission: NOT GRANTED" />

    <!--
        GRANT OVERLAY PERMISSION BUTTON
        ─────────────────────────────────
        Deep-links to the system "draw over other apps" settings screen for
        this app (Settings.ACTION_MANAGE_OVERLAY_PERMISSION). Same pattern
        as buttonOpenSettings above — Android requires a manual user action
        in system Settings, we cannot grant this to ourselves in code.
    -->
    <Button
        android:id="@+id/buttonOverlayPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_overlay_permission"
        app:layout_constraintTop_toBottomOf="@id/textViewOverlayStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!--
        SHOW OVERLAY BUTTON
        ─────────────────────
        Starts OverlayService (a foreground service) and shows the small
        draggable floating button over other apps. Only functional once
        overlay permission is granted — MainActivity checks this before
        starting the service and shows a message instead if it isn't.
    -->
    <Button
        android:id="@+id/buttonShowOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_show_overlay"
        app:layout_constraintTop_toBottomOf="@id/buttonOverlayPermission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!--
        HIDE OVERLAY BUTTON
        ─────────────────────
        Stops OverlayService, removing the floating button and its
        notification. Kept as a separate explicit button (rather than one
        clever toggle button) to match the existing explicit-button style
        of this screen and keep enable/disable logic easy to follow.
    -->
    <Button
        android:id="@+id/buttonHideOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_hide_overlay"
        app:layout_constraintTop_toBottomOf="@id/buttonShowOverlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!--
        TARGET TEST BUTTON (debugging aid — proves the injected tap is real)
        ──────────────────────────────────────────────────────────────────
        "Show taps" only proves a touch ripple was drawn — it does NOT prove
        the accessibility-injected gesture is a genuine input event that the
        Android input pipeline delivers to a view's click handler. This
        button's hitbox is positioned so its CENTER sits exactly on the
        injected tap's target point: x=504px, y=1038px (screen center on
        this device, 1008x2077).

        If pressing "Send Tap" triggers THIS button's own onClick (see
        MainActivity.kt), that's real functional proof performTap() works —
        the OS treated the synthetic gesture exactly like a real finger tap.

        Positioned with raw PIXEL margins (android:layout_marginStart/Top
        using a "px" suffix) instead of dp, so it lines up exactly with the
        pixel coordinates used in performTap() — no dp/px conversion math
        to get wrong. Size is 120px square, so:
            center = (444px + 60px, 978px + 60px) = (504px, 1038px)
    -->
    <Button
        android:id="@+id/buttonTargetTest"
        android:layout_width="120px"
        android:layout_height="120px"
        android:text="@string/btn_target_test"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="444px"
        android:layout_marginTop="978px" />

</androidx.constraintlayout.widget.ConstraintLayout>
