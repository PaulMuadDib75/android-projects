<?xml version="1.0" encoding="utf-8"?>

<!--
    res/layout/overlay_panel.xml
    ══════════════════════════════
    The floating button ROW itself — this is what OverlayService inflates
    and hands to WindowManager to draw on top of every other app.

    WHY LinearLayout (horizontal) INSTEAD OF THE ORIGINAL FrameLayout:
      Milestone 2 shipped this as a FrameLayout wrapping a single button,
      specifically so a later milestone could add more children without
      restructuring the file. Milestone 3 is that later milestone: it adds
      a second button (Record) next to the original tap-loop toggle, so a
      horizontal LinearLayout — which lays children out left-to-right in a
      row — replaces the FrameLayout.

      This swap is safe for OverlayService's existing drag/window code:
      WindowManager.addView()/updateViewLayout() only care about the ROOT
      View reference and the external layoutParams.x/y (top-left corner of
      the whole panel). How children are arranged INSIDE that root is
      invisible to WindowManager — so changing the container type here has
      zero effect on the M2 drag math in OverlayService.setupDragAndToggle().

    SIZE:
      Both buttons stay 56dp — the standard Material "large touch target"
      size — big enough to reliably drag/tap with a thumb, small enough to
      stay out of the way over whatever app is running underneath.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!--
        The tap-loop toggle button — UNCHANGED from Milestone 2. OverlayService
        sets its background to overlay_toggle_off.xml / overlay_toggle_on.xml
        depending on whether the tap loop is running, and attaches the
        drag-vs-tap touch listener directly to this view. Still the only
        view on the panel that can be dragged.

        contentDescription is read aloud by screen readers (TalkBack) —
        good practice for any touch target, and required by Android
        Studio's lint checks for View-based touch targets with no visible
        text.
    -->
    <View
        android:id="@+id/overlayToggleButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/overlay_toggle_off"
        android:contentDescription="@string/overlay_toggle_content_description"
        android:elevation="8dp" />

    <!--
        Milestone 3: the Record button. Deliberately gets a plain
        setOnClickListener() in OverlayService, NOT a setOnTouchListener()
        like the button above — a plain click listener already gives the
        "press down and release without moving far = a click" behavior for
        free, which is exactly the click-only semantics this button needs.
        It does not participate in dragging the panel; only the original
        button (above) does that.

        layout_marginStart separates it visually from the toggle button so
        the two touch targets don't feel like one wide button.
    -->
    <View
        android:id="@+id/overlayRecordButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/overlay_record_off"
        android:contentDescription="@string/overlay_record_content_description"
        android:elevation="8dp" />

</LinearLayout>
