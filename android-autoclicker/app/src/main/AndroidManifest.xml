<?xml version="1.0" encoding="utf-8"?>

<!--
    AndroidManifest.xml
    ════════════════════
    Every Android app has exactly one of these files. It is the "panel schedule"
    for the app — it tells the Android OS:
      • What this app is called and what it looks like
      • Which screens (Activities) and background workers (Services) it contains
      • What permissions and system integrations it requires
      • Which component should launch when the user taps the app icon

    Android reads this file at INSTALL TIME and at RUNTIME.
    Any component (Activity, Service) that isn't declared here cannot be used.
-->

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        ═══════════════════════════════════════════════════════════════════
        PERMISSIONS — Milestone 2
        Every permission below was flagged to Chris and explained BEFORE
        being added, per the project rule in CLAUDE.md. Keeping that
        explanation here too, so the "why" travels with the code.
        ═══════════════════════════════════════════════════════════════════
    -->

    <!--
        SYSTEM_ALERT_WINDOW
        WHY THIS IS NEEDED:
          This is what lets us draw a window that floats ON TOP of other
          apps (the whole point of Milestone 2's overlay button). Without
          it, WindowManager.addView() with TYPE_APPLICATION_OVERLAY throws
          a SecurityException.

          This is a SPECIAL permission — like the accessibility permission
          in M1, Android will NOT show a normal install-time or popup
          prompt for it. The user must be sent to a dedicated system
          Settings screen (Settings.canDrawOverlays() to check,
          ACTION_MANAGE_OVERLAY_PERMISSION to request) and flip it on
          manually. The app can never silently grant this to itself —
          that's a deliberate security gate, same reasoning as
          accessibility services being sensitive.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        FOREGROUND_SERVICE
        WHY THIS IS NEEDED:
          Since Android 9 (API 28), any service that wants to run as a
          "foreground service" — one Android won't casually kill to free
          memory, shown to the user via a persistent notification — must
          declare this permission. It's a "normal" permission: granted
          automatically at install time, no popup, no user action needed.

          We need our new OverlayService to be a foreground service so the
          floating button and its tap loop keep running reliably instead
          of getting killed a few minutes after the app is backgrounded.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        FOREGROUND_SERVICE_SPECIAL_USE
        WHY THIS IS NEEDED:
          Android 14 (API 34, our targetSdk) requires every foreground
          service to declare WHICH CATEGORY of work it's doing (camera,
          location, media playback, health, etc.) so the system can apply
          the right battery/resource rules to it. A floating auto-clicker
          control button doesn't fit any of those predefined categories,
          so we use the catch-all "specialUse" category instead — this
          permission is what unlocks using it. See the OverlayService
          <service> declaration below for the matching
          foregroundServiceType="specialUse" and justification <property>.

          Also a "normal" permission — auto-granted, no user prompt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        POST_NOTIFICATIONS
        WHY THIS IS NEEDED:
          A foreground service is legally required to show a notification
          (that's the whole deal — it's how the user always knows
          something is running in the background, even when the app
          itself isn't open). On Android 13+ (API 33+), showing ANY
          notification requires this runtime permission.

          Unlike the two "normal" permissions above, this one IS a real
          popup dialog the user can accept or deny — same category as
          things like camera/location permission requests. If the user
          denies it, our foreground service still runs fine; the
          notification just silently doesn't display. We request this
          from MainActivity, only on API 33+, after overlay permission is
          confirmed.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        ═══════════════════════════════════════════════════════════════════
        APPLICATION BLOCK
        Wraps all components (Activities, Services) belonging to this app.
        ═══════════════════════════════════════════════════════════════════

        android:label   — The app name shown in the launcher and task switcher.
                          Points to @string/app_name in res/values/strings.xml.
        android:theme   — The default visual style applied to every Activity.
                          Points to res/values/themes.xml.
        android:allowBackup — Whether Android can back up the app's data.
                              true is fine for M1; we have no sensitive data yet.
        android:supportsRtl — true = the layout mirrors correctly for right-to-left
                              languages like Arabic or Hebrew. Good practice to set.
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoClicker">

        <!--
            ═══════════════════════════════════════════════════════════════
            MAIN ACTIVITY
            The first screen the user sees when they launch the app.
            ═══════════════════════════════════════════════════════════════

            android:name     — The Kotlin class for this screen. The leading dot ( . )
                               is shorthand for "in the app's namespace package"
                               (com.example.autoclicker.MainActivity).
            android:exported — Must be "true" because the system launcher (outside
                               our app's process) needs to be able to start this Activity.
                               Without exported="true" on the main Activity, the app
                               icon does nothing when tapped.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!--
                INTENT FILTER — tells Android which "signals" this Activity responds to.
                ACTION_MAIN  = this is an entry point for the app
                CATEGORY_LAUNCHER = show it as an icon in the app launcher/home screen
                Together these two lines are what make an app icon appear in the drawer.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!--
            ═══════════════════════════════════════════════════════════════
            ACCESSIBILITY SERVICE DECLARATION
            This is the core of Milestone 1. Read this section carefully
            before approving — every attribute has a security reason.
            ═══════════════════════════════════════════════════════════════

            android:name
              The Kotlin class that implements the AccessibilityService.

            ───────────────────────────────────────────────────────────────
            android:exported="true"
            WHY THIS IS NEEDED:
              The Android Accessibility Framework runs in a DIFFERENT PROCESS
              from your app (it's part of the system_server process).
              If exported="false", the service is invisible to any process
              outside your app — including the system itself.
              Setting exported="true" opens the service's door to the outside
              world. (The 'permission' attribute below controls WHO may enter.)
            ───────────────────────────────────────────────────────────────

            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            WHY THIS IS NEEDED:
              Think of this as a LOCKOUT TAG on the service's connection port.
              It declares: "only a caller that HOLDS this permission may bind
              to this service." The Android system is the only entity that
              holds BIND_ACCESSIBILITY_SERVICE — no regular app does.

              Effect: no malicious app can bind to your service and fire fake
              taps. Only the system's accessibility framework can connect.

              IMPORTANT: This is NOT a user-facing permission. It will never
              appear in the app's permission list in Settings > App Info.
              It is a system-level binding restriction, invisible to the user.
            ───────────────────────────────────────────────────────────────

            android:label
              The name shown next to the service in Settings > Accessibility.
        -->
        <service
            android:name=".TapAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label">

            <!--
                ACCESSIBILITY SERVICE INTENT FILTER
                This exact action string is what makes Android recognise this
                as an accessibility service (not just a random background service).
                Without it, the service is ignored by the accessibility framework.
            -->
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <!--
                ACCESSIBILITY SERVICE METADATA
                ───────────────────────────────────────────────────────────────
                WHY THIS IS NEEDED:
                  This points to res/xml/accessibility_service_config.xml, which
                  is a configuration file that tells Android what the service does:
                    • What UI events it wants to receive
                    • Whether it can inject gestures (canPerformGestures)
                    • The description shown in the Settings > Accessibility screen

                  WITHOUT THIS TAG: the service is registered in the manifest but
                  never appears in Settings > Accessibility. The user cannot enable
                  it, and it can never run. This tag is mandatory.
                ───────────────────────────────────────────────────────────────
                android:name  — must be exactly this string; it's how Android
                                identifies accessibility service metadata.
                android:resource — path to the config XML file.
            -->
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />

        </service>


        <!--
            ═══════════════════════════════════════════════════════════════
            OVERLAY SERVICE DECLARATION — Milestone 2
            Hosts the floating draggable button and its tap-dispatch loop.
            ═══════════════════════════════════════════════════════════════

            android:name
              The Kotlin class implementing this foreground service.

            ───────────────────────────────────────────────────────────────
            android:exported="false"
            WHY THIS IS DIFFERENT FROM TapAccessibilityService ABOVE:
              TapAccessibilityService must be exported=true because the
              SYSTEM's accessibility framework (a different process) needs
              to bind to it. OverlayService is only ever started by OUR
              OWN MainActivity, in our own process — nothing outside this
              app ever needs to reach it, so we keep the door closed.
            ───────────────────────────────────────────────────────────────

            android:foregroundServiceType="specialUse"
            WHY THIS IS NEEDED:
              Required on API 34+ for any foreground service — declares
              which system-recognised category of work this service does.
              "specialUse" is the catch-all category for services (like
              this one) that don't fit camera/location/mediaPlayback/etc.
              Must be paired with the FOREGROUND_SERVICE_SPECIAL_USE
              permission declared above, and the justification <property>
              below.
        -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <!--
                PROPERTY_SPECIAL_USE_FGS_SUBTYPE
                Not a permission — a plain-text justification string. This
                isn't shown to the user; it's what Google Play's review
                process reads to confirm "specialUse" isn't being used to
                dodge the real foreground-service category rules.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays a floating control button to start and stop automated taps while other apps are in the foreground" />

        </service>

    </application>

</manifest>
